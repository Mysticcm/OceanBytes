<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
    <header class="ob-header">
        <%- include('partials/navbar') %>
    </header>

    <section id="signup" class="section">
        <div class="container">
            <h2>Start din gratis prøveperiode</h2>
            <p>Fyll ut skjemaet nedenfor for å opprette en konto og utforske OceanBytes i 30 dager.</p>

            <form action="/signup" method="post" class="signup-form">
                <div class="form-group row mt-2">
                    <label class="col-1" for="username">Navn</label>
                    <input class="col-3" type="text" id="username" name="username" required />
                </div>

                <div class="form-group row mt-2">
                    <label class="col-1" for="email">E-post</label>
                    <input class="col-3" type="email" id="email" name="email" required />
                </div>

                <div class="form-group row mt-2">
                    <label class="col-1" for="password">Passord</label>
                    <input class="col-3" type="password" id="password" name="password" required />
                </div>

                <button type="submit" class="btn primary mt-2">Opprett konto</button>
            </form>
        </div>
    </section>
</body>
</html>