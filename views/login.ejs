<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
    <header class="ob-header">
        <%- include('partials/navbar') %>
    </header>

    <section id="signup" class="section">
        <div class="container">
            <h2>Har du en bruker?</h2>
            <p>Log in her, eller <a href="/signup">registrer deg</a> for å bli kunde</p>

            <form action="/login/password" method="post" class="signup-form">

                <div class="form-group row mt-2">
                    <label class="col-1" for="email">E-post</label>
                    <input class="col-3" type="email" id="email" name="email" required />
                </div>

                <div class="form-group row mt-2">
                    <label class="col-1" for="password">Passord</label>
                    <input class="col-3" type="password" id="password" name="password" required />
                </div>

                <button type="submit" class="btn primary mt-2 fw-medium">Log in</button>
            </form>
        </div>
    </section>
</body>
</html>